# Copy to .env and fill in. .env is gitignored — never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# The refinement step uses a stronger model (mini degenerates on its nested schema).
OPENAI_REFINE_MODEL=gpt-4o

# Optional (sensible defaults if omitted)
TOP_N_CANDIDATES=5
OPENAI_TIMEOUT=120
